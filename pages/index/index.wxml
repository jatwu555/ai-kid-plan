<!-- pages/index/index.wxml —— 首页：编辑式目录 + 首次须知弹窗 -->
<view class="page">

  <!-- 顶部标题区：左对齐编辑式排版 + AI 小伙伴 -->
  <view class="header">
    <view class="header-row">
      <view class="header-text">
        <view class="eyebrow">5 天启蒙计划</view>
        <view class="title">和孩子一起认识 AI</view>
      </view>
      <image class="bot-img" src="{{botSrc}}" mode="aspectFit"/>
    </view>
  </view>

  <!-- 课程目录：章节式列表，大数字为视觉锚点 -->
  <view class="toc">
    <view
      class="toc-row {{pressedId === item.id ? 'is-pressed' : ''}} {{lastRead.id === item.id ? 'is-current' : ''}}"
      wx:for="{{courses}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCourseTap"
      bindtouchstart="onRowPressStart"
      bindtouchend="onRowPressEnd"
      bindtouchcancel="onRowPressEnd"
    >
      <view class="toc-num">{{item.num}}</view>
      <view class="toc-main">
        <view class="toc-title-line">
          <text class="toc-title {{item.done ? 'is-done' : ''}}">{{item.title}}</text>
          <view class="done-badge" wx:if="{{item.done}}">
            <view class="done-check"></view>
          </view>
          <text class="now-tag" wx:if="{{lastRead.id === item.id && !item.done}}">继续学习</text>
        </view>
        <view class="toc-desc">{{item.desc}}</view>
      </view>
      <view class="toc-arrow">→</view>
    </view>
  </view>

  <!-- 邀请朋友一起学：轻量横条入口，open-type=share 拉起微信原生分享 -->
  <view class="invite">
    <view class="invite-text">
      <view class="invite-desc">和朋友一起学习ai，邀请他们接受挑战～</view>
    </view>
    <button
      class="invite-btn"
      open-type="share"
      hover-class="invite-btn-hover"
    >邀请朋友</button>
  </view>

  <!-- 底部说明 + 温馨提示入口（点击再次查看家长须知） -->
  <view class="foot">适读 5～10 岁 · 请家长陪同一起使用</view>
  <view class="notice-entry" hover-class="notice-entry-hover" hover-stay-time="80" bindtap="onNoticeEntryTap">
    <text class="notice-entry-heart"></text>
    <text>温馨提示</text>
  </view>
</view>

<!-- 家长须知弹窗：首次使用自动弹出，点「知道了」后不再自动弹出；可从底部「温馨提示」再次唤起 -->
<view class="mask" wx:if="{{showNotice}}" catchtouchmove="preventTouchMove">
  <view class="sheet">
    <view class="sheet-panel">
      <view class="sheet-head">
        <view class="sheet-head-text">
          <view class="sheet-eyebrow"><text class="eyebrow-heart"></text>给家长的小提醒</view>
          <view class="sheet-title">
            <view class="title-line">陪孩子一起</view>
            <view class="title-line">开启 <text class="title-accent">AI</text> 启蒙</view>
          </view>
        </view>
        <image class="sheet-illus" src="/assets/notice-illustration.jpg" mode="aspectFit" />
      </view>

      <view class="notice-list">
        <view class="notice-item">
          <view class="notice-icon notice-icon-family"></view>
          <text class="notice-text">本内容适合 5-10 岁孩子使用，建议家长陪伴孩子一起探索、一起提问。</text>
        </view>
        <view class="notice-divider"></view>
        <view class="notice-item">
          <view class="notice-icon notice-icon-safe"></view>
          <text class="notice-text">适度的 AI 互动，可以帮助孩子练习表达、培养思考与逻辑。</text>
        </view>
        <view class="notice-divider"></view>
        <view class="notice-item">
          <view class="notice-icon notice-icon-time"></view>
          <text class="notice-text">也请您协助孩子合理安排使用时长，养成健康的屏幕使用习惯，让科技更好地陪伴成长。</text>
        </view>
      </view>

      <view class="sheet-btn" hover-class="sheet-btn-hover" hover-stay-time="80" bindtap="onKnowTap">知道了</view>
    </view>
  </view>
</view>
