/* pages/poster/poster.wxss —— 挑战完成分享页：极简三段式
   色板沿用全局：暖纸 #FAF6EF / 墨色 #2E2822 / 赤陶橙 #C25330 / 奶油 #FBEFD7 / 暖灰 #8A7B6B */
.page {
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── ① 完成反馈：紧凑居中 ── */
.done-head {
  text-align: center;
  padding: 12rpx 0 8rpx;
}
.done-title-row {
  position: relative;
  display: inline-block;
}
.done-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #2E2822;
  letter-spacing: 2rpx;
}
/* 轻量星光：只做点缀，不抢内容 */
.spark {
  position: absolute;
  background: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path d='M10 0c.9 5.5 4.6 9.1 10 10-5.4.9-9.1 4.5-10 10-.9-5.5-4.6-9.1-10-10C5.4 9.1 9.1 5.5 10 0z' fill='%23E8A13C'/></svg>") center/contain no-repeat;
}
.spark-l {
  width: 30rpx;
  height: 30rpx;
  left: -46rpx;
  top: -12rpx;
}
.spark-r {
  width: 20rpx;
  height: 20rpx;
  right: -36rpx;
  top: -18rpx;
  opacity: 0.6;
}
.done-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A7B6B;
}

/* ── ② 海报：白色大圆角卡片，padding-bottom 撑出固定 3:4 ── */
.poster {
  position: relative;
  width: 100%;
  height: 0;
  margin-top: 28rpx;
  padding-bottom: 133.333%;
  border-radius: 48rpx;
  background: #FFFDF8;
  box-shadow: 0 12rpx 40rpx rgba(92, 70, 40, 0.10);
  overflow: hidden;
}
.poster-inner {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 40rpx 40rpx;
  text-align: center;
}
.poster-tag {
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  background: #FBEFD7;
  color: #B5502C;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.poster-day {
  margin-top: auto; /* 与二维码组的 auto 等分剩余空间，中部内容垂直居中不留大空档 */
  font-size: 52rpx;
  font-weight: 800;
  color: #2E2822;
  line-height: 1.3;
}
.day-num {
  color: #C25330;
}
.poster-course {
  margin-top: 18rpx;
  max-width: 100%;
  font-size: 30rpx;
  font-weight: 700;
  color: #2E2822;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.poster-progress {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.star {
  font-size: 44rpx;
  line-height: 1;
  color: #E4D9C6;
}
.star.on {
  color: #F0B63A;
}
.poster-qr {
  margin-top: auto; /* 与完成天数的 auto 等分剩余空间 */
  width: 216rpx;
  height: 216rpx;
  padding: 10rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 2rpx solid #F0E7D6;
  border-radius: 16rpx;
}
.qr-img {
  width: 100%;
  height: 100%;
}
.poster-qr-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8A7B6B;
}

/* AI 机器人：完成氛围元素，轻微上下浮动 */
.poster-bot {
  width: 128rpx;
  height: 154rpx;
  margin-top: 28rpx;
  animation: bot-float 3.2s ease-in-out infinite;
}
@keyframes bot-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* ── ③ 分享操作：与海报明显分隔 ── */
.share-bar {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}
.share-btn {
  flex: 1;
  margin: 0;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.btn-ic {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}
.share-btn::after {
  border: none;
}
.share-btn.main {
  background: #C25330;
  color: #FFFFFF;
}
.share-btn.main-hover {
  background: #A84527;
}
.share-btn.sub {
  background: #FFFFFF;
  color: #C25330;
  border: 2rpx solid #C25330;
  box-sizing: border-box;
}
.share-btn.sub-hover {
  background: #FBEFD7;
}

/* ── 底部弱操作：返回课程 ── */
.back-row {
  margin-top: 20rpx;
  text-align: center;
}
.back-link {
  display: inline-block;
  padding: 16rpx 40rpx;
  font-size: 24rpx;
  color: #A2937F;
}
.back-link-hover {
  opacity: 0.6;
}

/* ── 朋友圈引导弹层（沿用原样式） ── */
.tl-tip-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(46, 40, 34, 0.55);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tl-tip {
  width: 540rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}
.tl-tip-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2E2822;
}
.tl-tip-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #6E6153;
  line-height: 1.8;
  text-align: left;
}
.tl-tip-btn {
  margin-top: 36rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: #C25330;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 700;
  border-radius: 42rpx;
}
