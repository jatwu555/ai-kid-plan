<!-- pages/poster/poster.wxml —— 挑战完成分享页：①完成反馈 ②海报预览（固定3:4） ③分享操作
     海报为 WXML 版式预览；小程序码接入后替换 qrSrc 即可，版式与比例不变 -->
<view class="page">

  <!-- ① 完成反馈：紧凑居中，尽快让位给海报 -->
  <view class="done-head">
    <view class="done-title-row">
      <view class="spark spark-l"></view>
      <text class="done-title">挑战完成 🎉</text>
      <view class="spark spark-r"></view>
    </view>
    <view class="done-sub">今天又和孩子一起认识了一点 AI</view>
  </view>

  <!-- ② 分享海报预览：白色大圆角卡片，padding-bottom 撑出固定 3:4 比例 -->
  <view class="poster">
    <view class="poster-inner">
      <view class="poster-tag">每天 5 分钟，和孩子一起认识 AI</view>
      <view class="poster-day">完成第 <text class="day-num">{{day}}</text> 天</view>
      <view class="poster-course">《{{title}}》</view>

      <view class="poster-progress">
        <text wx:for="{{stars}}" wx:key="index" class="star {{item.on ? 'on' : ''}}">{{item.on ? '★' : '☆'}}</text>
      </view>

      <image class="poster-bot" src="{{botSrc}}" mode="aspectFit" />

      <view class="poster-qr">
        <image class="qr-img" src="{{qrSrc}}" mode="aspectFit" />
      </view>
      <view class="poster-qr-label">扫码一起认识 AI</view>
    </view>
  </view>

  <!-- ③ 分享操作：与海报区明显分隔 -->
  <view class="share-bar">
    <button class="share-btn main" open-type="share" hover-class="main-hover">
      <image class="btn-ic" src="/assets/icon-wechat-white.png" mode="aspectFit" />
      <text>微信好友</text>
    </button>
    <button class="share-btn sub" bindtap="onShareTimelineTap" hover-class="sub-hover">
      <image class="btn-ic" src="/assets/icon-moments.png" mode="aspectFit" />
      <text>朋友圈</text>
    </button>
  </view>

  <!-- 底部弱操作：只留一个返回 -->
  <view class="back-row">
    <text class="back-link" bindtap="onBackCourse" hover-class="back-link-hover">返回课程</text>
  </view>
</view>

<!-- 朋友圈分享引导：官方能力受限时引导右上角菜单 -->
<view class="tl-tip-mask" wx:if="{{showTimelineTip}}" bindtap="onCloseTimelineTip" catchtouchmove="preventTouchMove">
  <view class="tl-tip">
    <view class="tl-tip-title">分享到朋友圈</view>
    <view class="tl-tip-text">请点击右上角「···」→「分享到朋友圈」，把挑战成果分享给朋友们。</view>
    <view class="tl-tip-btn" bindtap="onCloseTimelineTip">我知道了</view>
  </view>
</view>
