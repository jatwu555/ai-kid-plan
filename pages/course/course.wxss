/* pages/course/course.wxss —— 详情页：温暖 + 简洁 + 轻儿童 + 亲子陪伴
   保留米白底 #FAF6EF + 赤陶橙 #C25330 + 深棕墨色 #2E2822 品牌体系 */
.page {
  padding: 48rpx 40rpx 80rpx;
  min-height: 100vh;
}

/* ── 标题区 ── */
.head {
  padding: 0 8rpx 36rpx;
}
.title {
  font-size: 52rpx;
  font-weight: 800;
  color: #2E2822;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

/* ── 视频区域 ── */
.video-wrap {
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(92, 70, 40, 0.08);
  background: #1A1613;
}
.video {
  width: 100%;
  height: 400rpx;
}

/* ── 白色信息面板：卡片间距加大，减少细分割线 ── */
.panel {
  margin-top: 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 36rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(92, 70, 40, 0.06);
}
.panel-label {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #2E2822;
  margin-bottom: 20rpx;
}

/* 今天认识一个新朋友：AI 小伙伴头像 + 标题 */
.bot-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  animation: bot-breathe 3.6s ease-in-out infinite;
}
@keyframes bot-breathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}
.remember-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 22rpx;
}
.remember-top .panel-label {
  margin-bottom: 0;
  letter-spacing: 1rpx;
}
.remember-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2E2822;
  line-height: 1.8;
}

/* ── 亲子任务 ── */
.task-item {
  padding: 22rpx 0;
  border-top: 1rpx solid #F3ECDF;
}
.task-item:first-of-type {
  border-top: none;
  padding-top: 0;
}
.task-main {
  display: flex;
  align-items: flex-start;
}
/* 动词小标签：想一想 / 找一找 … */
.task-verb {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 2rpx 16rpx;
  border-radius: 12rpx;
  background: #FAEFE6;
  color: #C25330;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.7;
}
.task-text {
  flex: 1;
  font-size: 30rpx;
  color: #3B332A;
  line-height: 1.75;
}

/* 今天请孩子说一句：轻互动提示（无输入框、无记录） */
.say-line {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  background: #F7F1E4;
  border-radius: 20rpx;
}
.say-label {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #B5502C;
  margin-bottom: 10rpx;
}
.say-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2E2822;
  line-height: 1.6;
}

/* ── 滑动完成今天的探索 ──
   未完成：米色滑轨 + 白色滑块（赤陶橙箭头）
   已完成：绿色滑轨锁定 + 白色对勾，不可再操作 */
.slide-track {
  position: relative;
  margin-top: 44rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: #F1E8D8;
  overflow: hidden;
  transition: background-color 0.3s ease;
}
.slide-track.is-done {
  background: #3E9670;
}
.slide-text {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  text-align: center;
  line-height: 108rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: #A2937F;
  transition: color 0.3s ease, opacity 0.3s ease;
}
.slide-track.is-done .slide-text {
  color: #FFFFFF;
  font-weight: 600;
}
.slide-knob {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(92, 70, 40, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
  z-index: 2;
}
.slide-knob.is-dragging {
  transition: none;
}
.knob-arrow {
  width: 22rpx;
  height: 22rpx;
  border-top: 5rpx solid #C25330;
  border-right: 5rpx solid #C25330;
  transform: rotate(45deg);
  margin-left: -8rpx;
}
.knob-check {
  width: 26rpx;
  height: 14rpx;
  border-left: 5rpx solid #3E9670;
  border-bottom: 5rpx solid #3E9670;
  border-radius: 2rpx;
  transform: rotate(-45deg);
  margin-top: -6rpx;
}

/* ── 挑战完成弹窗：全屏半透明遮罩 + 白色圆角弹窗 ── */
.done-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(46, 40, 34, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  transition: opacity 0.25s ease;
}
.done-mask.is-show {
  opacity: 1;
}
.done-pop {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 56rpx 44rpx 44rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(46, 40, 34, 0.25);
  transform: translateY(30rpx) scale(0.96);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.done-mask.is-show .done-pop {
  transform: translateY(0) scale(1);
}
.pop-bot {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  display: block;
  animation: pop-bot-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes pop-bot-in {
  from { opacity: 0; transform: translateY(-20rpx) scale(0.6); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.pop-title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #2E2822;
  letter-spacing: 2rpx;
  animation: pop-fade 0.45s ease 0.1s both;
}
.pop-course {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #6E6153;
  animation: pop-fade 0.45s ease 0.2s both;
}
.pop-progress {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  animation: pop-fade 0.45s ease 0.3s both;
}
.pop-star {
  color: #F0B63A;
  font-size: 28rpx;
}
.pop-progress-text {
  font-size: 27rpx;
  font-weight: 700;
  color: #C25330;
}
.pop-stars {
  margin-top: 14rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  animation: pop-fade 0.45s ease 0.35s both;
}
.pop-star-mark {
  font-size: 40rpx;
  color: #E8DFCE;
  transition: color 0.3s ease;
}
.pop-star-mark.is-on {
  color: #F0B63A;
}
.pop-main-btn {
  margin-top: 44rpx;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  background: #C25330;
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  border-radius: 46rpx;
  animation: pop-fade 0.45s ease 0.4s both;
}
.pop-main-btn::after {
  border: none;
}
.pop-main-btn-hover {
  background: #A84527;
}
.pop-sub-btn {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #A2937F;
  text-align: center;
  padding: 10rpx;
  animation: pop-fade 0.45s ease 0.5s both;
}
@keyframes pop-fade {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
